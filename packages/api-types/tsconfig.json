{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "paths": {
      "src/app-api/types": ["../../src/app-api/types/index.ts"],
      // The app source uses the `@/` alias rooted at src/. Without this the
      // dts build fails on the first aliased import it walks into (TS2307 on
      // `@/models/NetworkModel` from VisualStyleModel/VisualStyleFn.ts).
      "@/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
