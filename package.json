{
  "name": "cytoscape-web",
  "version": "1.1.0-dev.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "keywords": [
    "cytoscape",
    "graph",
    "graph drawing",
    "network",
    "visualization",
    "bioinformatics"
  ],
  "description": "Cytoscape Web: A web-based network visualization tool for modern web browsers",
  "author": {
    "name": "The Cytoscape Consortium",
    "url": "https://cytoscape.org"
  },
  "homepage": "http://web.cytoscape.org",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cytoscape/cytoscape-web.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "test": "run-s test:checks test:e2e:chromium",
    "test:quiet": "run-s test:checks:quiet test:e2e:chromium:quiet",
    "test:checks": "run-p --aggregate-output lint test:unit",
    "test:checks:quiet": "run-p --aggregate-output lint test:unit:quiet",
    "test:unit": "vitest run",
    "test:unit:quiet": "cross-env CYWEB_TEST_QUIET=1 vitest run --reporter=minimal",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:quiet": "cross-env CYWEB_TEST_QUIET=1 vitest run --coverage --reporter=minimal",
    "test:e2e": "run-s build:test-remote \"e2e:run -- {@}\" --",
    "test:e2e:quiet": "run-s build:test-remote:quiet \"e2e:run:quiet -- {@}\" --",
    "test:e2e:chromium": "run-s build:test-remote \"e2e:run -- --project=chromium\"",
    "test:e2e:chromium:quiet": "run-s build:test-remote:quiet \"e2e:run:quiet -- --project=chromium\"",
    "e2e:spec": "run-s build:test-remote:quiet \"e2e:spec:run -- {@}\" --",
    "e2e:spec:run": "node scripts/run-playwright.mjs --project=chromium --quiet --reporter=test/playwright/quiet-reporter.ts",
    "e2e:run": "node scripts/run-playwright.mjs",
    "e2e:run:quiet": "node scripts/run-playwright.mjs --quiet --reporter=test/playwright/quiet-reporter.ts",
    "build:test-remote": "vite build --config test/fixtures/remote-app/vite.config.ts",
    "build:test-remote:quiet": "vite build --config test/fixtures/remote-app/vite.config.ts --logLevel error",
    "verify:federation": "ts-node --transpileOnly --compilerOptions \"{\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" scripts/verify-federation-build.ts",
    "build": "vite build",
    "dev": "vite --host --open",
    "watch": "vite --host --open",
    "dev:local": "vite --host --open",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "build:api-types": "npm run build --workspace=packages/api-types",
    "lint": "run-p --aggregate-output lint:tsc lint:oxlint",
    "lint:oxlint": "oxlint src",
    "lint:tsc": "tsc --noEmit",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "benchmark": "node benchmark/report.mjs",
    "benchmark:all": "node benchmark/report.mjs --all",
    "benchmark:full": "node benchmark/report.mjs --full",
    "benchmark:browser": "node --import tsx benchmark/browser-bench.mjs",
    "benchmark:publish": "node scripts/benchmark-publish.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@module-federation/vite": "1.16.8",
    "@mui/types": "^7.2.0",
    "@playwright/test": "1.61.0",
    "@testing-library/react": "^16.0.0",
    "@types/chroma-js": "^2.1.4",
    "@types/cytoscape": "^3.19.9",
    "@types/d3-array": "^3.0.4",
    "@types/d3-color": "^3.1.0",
    "@types/d3-hierarchy": "^3.1.3",
    "@types/d3-scale": "^4.0.3",
    "@types/d3-scale-chromatic": "^3.0.0",
    "@types/d3-selection": "^3.0.7",
    "@types/d3-zoom": "^3.0.5",
    "@types/debug": "^4.1.12",
    "@types/js-cookie": "^3.0.3",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.0.20",
    "@types/react-color": "^3.0.6",
    "@types/react-dom": "^18.0.6",
    "@types/safe-regex": "^1.1.6",
    "@types/semver": "^7.7.1",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "@welldone-software/why-did-you-render": "^8.0.3",
    "baseline-browser-mapping": "^2.8.32",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^4.0.0",
    "isomorphic-fetch": "^3.0.0",
    "jsdom": "^29.1.1",
    "mitata": "^1.0.34",
    "node-fetch": "^3.2.10",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.73.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vite": "8.0.13",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@antv/layout": "^0.3.25",
    "@cosmograph/cosmos": "^1.3.0",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@glideapps/glide-data-grid": "^5.2.1",
    "@js4cytoscape/ndex-client": "^0.6.0-alpha.6",
    "@module-federation/runtime": "2.5.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@tabler/icons-react": "^2.19.0",
    "@tanstack/react-query": "^5.25.0",
    "@tiptap/extension-highlight": "^2.0.3",
    "@tiptap/extension-link": "^2.0.3",
    "@tiptap/extension-subscript": "^2.0.3",
    "@tiptap/extension-superscript": "^2.0.3",
    "@tiptap/extension-text-align": "^2.0.3",
    "@tiptap/extension-underline": "^2.0.3",
    "@tiptap/pm": "^2.0.3",
    "@tiptap/react": "^2.0.3",
    "@tiptap/starter-kit": "^2.0.3",
    "@visx/axis": "^3.0.0",
    "@visx/gradient": "^3.0.0",
    "@visx/group": "^3.0.0",
    "@visx/scale": "^3.0.0",
    "@visx/shape": "^3.0.0",
    "allotment": "1.18.1",
    "chroma-js": "^2.4.2",
    "cytoscape": "^3.34.0",
    "cytoscape-biological-flow": "^1.0.0",
    "cytoscape-canvas": "^3.0.1",
    "cytoscape-pdf-export": "^0.0.4",
    "cytoscape-svg": "^0.4.0",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "debug": "^4.4.1",
    "dexie": "3.2.7",
    "dexie-observable": "4.0.1-beta.13",
    "file-saver": "^2.0.5",
    "fuse.js": "^6.6.2",
    "hotkeys-js": "^4.0.4",
    "html-react-parser": "^3.0.12",
    "immer": "^10.0.2",
    "js-cookie": "^3.0.5",
    "keycloak-js": "25.0.1",
    "lodash": "^4.17.21",
    "mui-nested-menu": "^3.2.0",
    "openai": "^4.18.0",
    "papaparse": "^5.4.1",
    "react": "18.3.1",
    "react-color": "^2.19.3",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "18.3.1",
    "react-draggable": "^4.4.5",
    "react-error-boundary": "^4.0.13",
    "react-ga4": "^2.1.0",
    "react-joyride": "^3.2.0",
    "react-router-dom": "^6.20.1",
    "safe-regex": "^2.1.1",
    "semver": "^7.8.4",
    "uuid": "^9.0.0",
    "zod": "^3.25.56",
    "zustand": "^4.4.7"
  }
}
